<footer class="mt-4 py-4 border-t border-base-200 text-sm text-base-content/70 flex flex-col items-center gap-1 text-center">
  <span class="font-bold text-base text-base-content"><%= metadata.title %></span>
  <a href="<%= metadata.google_maps_url %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-primary transition-colors group">
    <svg class="size-4 shrink-0 fill-current opacity-70 group-hover:opacity-100" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512">
      <path d="M215.7 499.2C267.1 435 384 279.4 384 192C384 86 298 0 192 0S0 86 0 192c0 87.4 117 243 168.3 307.2c12.3 15.3 35.1 15.3 47.4 0zM192 128a64 64 0 1 1 0 128 64 64 0 1 1 0-128z"/>
    </svg>
    <span class="underline underline-offset-4 decoration-base-300 group-hover:decoration-primary"><%= metadata.street_address %>, <%= metadata.postal_code %> <%= metadata.city %> (<%= metadata.province %>)</span>
  </a>
  <a href="tel:<%= metadata.phone.delete(' ') %>" class="hover:text-primary transition-colors"><%= metadata.phone %></a>
</footer>
